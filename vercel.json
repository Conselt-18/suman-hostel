{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/((?!assets/|media/|favicon.ico|robots.txt|.*\\..*).*)", "destination": "/index.html" }
  ]
}
